{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd api && gradlew.bat bootRun"],
      "port": 8080,
      "url": "http://localhost:8080"
    },
    {
      "name": "web",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd web && npm run dev -- --strictPort"],
      "port": 5173,
      "url": "http://localhost:5173"
    }
  ]
}
